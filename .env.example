# Base URL 9router (jalankan 9router dulu, default port 20128)
NINEROUTER_BASE_URL=http://localhost:20128/v1

# API key dari dashboard 9router (Bearer token)
NINEROUTER_API_KEY=

# Opsional: daftar model dipisah koma, format provider/model.
# Kosongkan untuk memakai daftar default di lib/models.ts
AIGWEH_MODELS=

# Supabase untuk penyimpanan memori. Jalankan supabase/schema.sql di SQL Editor dulu.
# SERVICE_ROLE_KEY hanya dipakai di server. Jangan pernah dikirim ke browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
